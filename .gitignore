# Keep our custom theme
!/wp-content/themes/scarf/
!/wp-content/themes/scarf/**

# Keep our custom plugins that start with scart
!/wp-content/plugins/scart*/
!/wp-content/plugins/scart*/**

# Languages - downloaded/generated by WordPress
/wp-content/languages/

